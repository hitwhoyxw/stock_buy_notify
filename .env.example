# --- 数据源 ---
TUSHARE_TOKEN=

# --- 推送通道 ---
# 企业微信群机器人：新建群 → 添加群机器人 → 复制 webhook 中 key= 后面的部分
WECOM_BOT_KEY=

# 飞书机器人：自建应用或群机器人的完整 webhook URL
LARK_WEBHOOK=

# 邮箱 SMTP（QQ/163 请使用授权码而非登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# 客户端后端拉取台账用（只读，可随时 rotate）
CLIENT_API_TOKEN=
