<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThreeBucket.UI.ViewModels"
        x:Class="ThreeBucket.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="三桶策略系统 — Avalonia 跨平台原型"
        Width="900" Height="600">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="三桶策略系统 · Avalonia 跨平台原型" FontSize="20" FontWeight="Bold" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Text="{Binding SymbolText}" Watermark="代码，如 sh600519,sz000001" Width="320" />
      <Button Content="拉取行情" Command="{Binding FetchCommand}" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Quotes}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="100" />
            <TextBlock Text="{Binding Symbol}" Width="90" Foreground="Gray" />
            <TextBlock Text="{Binding Current, StringFormat='现价 {0}'}" Width="120" />
            <TextBlock Text="{Binding PrevClose, StringFormat='昨收 {0}'}" Width="120" />
            <TextBlock Text="{Binding High, StringFormat='高 {0}'}" Width="100" />
            <TextBlock Text="{Binding Low, StringFormat='低 {0}'}" Width="100" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</Window>
