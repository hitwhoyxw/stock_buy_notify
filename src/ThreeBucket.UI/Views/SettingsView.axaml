<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThreeBucket.UI.Views.SettingsView"
             x:CompileBindings="False">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="6">
      <TextBlock Text="⚙️ 设置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      <Button x:Name="SaveBtn" Content="💾 保存设置" Background="#27ae60" Foreground="White" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel x:Name="Form" Margin="10" Spacing="10" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
