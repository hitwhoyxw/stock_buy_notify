<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThreeBucket.UI.Views.DashboardView"
             x:CompileBindings="False">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6">
      <TextBlock Text="📊 任务面板" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      <Button x:Name="DailyBtn" Content="▶ 风控+台账 (T1→T8)" Background="#27ae60" Foreground="White" />
      <Button x:Name="T6Btn" Content="▶ 候选池 ABC" Background="#8e44ad" Foreground="White" />
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="220" />
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" Margin="6">
        <WrapPanel x:Name="Cards" Orientation="Horizontal" />
      </ScrollViewer>

      <DockPanel Grid.Row="1" Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="运行日志（实时输出）" FontWeight="Bold" VerticalAlignment="Center" />
          <Button x:Name="ClearLogBtn" Content="清除" />
        </StackPanel>
        <TextBox x:Name="Log" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas, Menlo, monospace" FontSize="12"
                 Background="#1e1e1e" Foreground="#d4d4d4" />
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
