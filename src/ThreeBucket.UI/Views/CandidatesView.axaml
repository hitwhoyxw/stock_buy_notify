<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:Avalonia.Controls"
             x:Class="ThreeBucket.UI.Views.CandidatesView"
             x:CompileBindings="False">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="6">
      <TextBlock Text="📋 候选池" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      <ComboBox x:Name="BucketCombo" Width="150" SelectedIndex="0">
        <ComboBoxItem Content="A — 红利逆向" />
        <ComboBoxItem Content="B — 成长" />
        <ComboBoxItem Content="C — 热点周期" />
      </ComboBox>
      <CheckBox x:Name="InstFilter" Content="只看有机构持仓" VerticalAlignment="Center" />
      <TextBox x:Name="SearchBox" Watermark="搜索代码/名称…" Width="200" />
      <Button x:Name="RefreshBtn" Content="🔄 刷新" />
      <TextBlock x:Name="Stats" Foreground="#666" FontSize="12" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="Detail" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
               Foreground="#495057" Background="#f8f9fa" Padding="8" MaxHeight="70" />
    <data:DataGrid x:Name="Grid" Margin="6" AutoGenerateColumns="False"
                   IsReadOnly="True" GridLinesVisibility="All" SelectionMode="Single">
      <data:DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="AddWatch" Header="🎯 加入监控自选" />
          <MenuItem x:Name="AddedWatch" Header="✅ 已在监控池" IsEnabled="False" />
        </ContextMenu>
      </data:DataGrid.ContextMenu>
    </data:DataGrid>
  </DockPanel>
</UserControl>
