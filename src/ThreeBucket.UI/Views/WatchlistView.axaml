<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:Avalonia.Controls"
             x:Class="ThreeBucket.UI.Views.WatchlistView"
             x:CompileBindings="False">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="6">
      <TextBlock Text="🎯 监控自选" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      <Button x:Name="AddBtn" Content="➕ 手动添加" Background="#27ae60" Foreground="White" />
      <Button x:Name="DelBtn" Content="🗑 移除" Background="#e74c3c" Foreground="White" />
      <Button x:Name="BindBtn" Content="📋 绑定策略" Background="#8e44ad" Foreground="White" />
      <Button x:Name="NoteBtn" Content="📝 备注" />
      <Button x:Name="RefreshBtn" Content="🔄 拉行情+评估" Background="#3498db" Foreground="White" />
      <TextBlock x:Name="Info" Foreground="#666" FontSize="12" VerticalAlignment="Center" />
    </StackPanel>

    <Grid ColumnDefinitions="2*,1*">
      <data:DataGrid x:Name="WatchGrid" Grid.Column="0" Margin="6" AutoGenerateColumns="False"
                     IsReadOnly="True" GridLinesVisibility="All" SelectionMode="Single">
        <data:DataGrid.Columns>
          <data:DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="90" />
          <data:DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100" />
          <data:DataGridTextColumn Header="现价" Binding="{Binding Price, StringFormat=F2}" Width="80" />
          <!-- 格式串必须含数字占位符："+F1" 无占位符会把数字丢掉只输出字面量 "+F1"；\% 转义避免值被乘 100 -->
          <data:DataGridTextColumn Header="涨跌%" Binding="{Binding ChangePct, StringFormat='+0.0\%;-0.0\%'}" Width="70" />
          <data:DataGridTextColumn Header="策略" Binding="{Binding Strategies}" Width="110" />
          <data:DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="120" />
          <data:DataGridTextColumn Header="加入时间" Binding="{Binding AddedAt}" Width="*" />
        </data:DataGrid.Columns>
      </data:DataGrid>

      <DockPanel Grid.Column="1" Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="触发历史" FontWeight="Bold" />
        <Button DockPanel.Dock="Bottom" x:Name="ClearBtn" Content="清空历史" HorizontalAlignment="Left" />
        <data:DataGrid x:Name="HistoryGrid" Margin="0,6,0,6" AutoGenerateColumns="False"
                       IsReadOnly="True" GridLinesVisibility="All">
          <data:DataGrid.Columns>
            <data:DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="120" />
            <data:DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="80" />
            <data:DataGridTextColumn Header="策略" Binding="{Binding StrategyName}" Width="*" />
            <data:DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="*" />
          </data:DataGrid.Columns>
        </data:DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
