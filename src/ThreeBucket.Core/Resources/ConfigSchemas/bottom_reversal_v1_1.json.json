        "fixed_pct": 0.08,
        "atr_period": 14,
        "buffer_pct": 0.02,
        "buffer_atr_mult": 0.5,
        "min_atr_mult": 1.0,
        "max_stop_pct": 0.1,
        "too_far_action": "cap",
        "rr_basis": "final"
