<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ThreeBucket.Core</RootNamespace>
    <AssemblyName>ThreeBucket.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- GBK/GB2312 等中文编码在 .NET Core 需显式引入 CodePages 提供程序 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- CSV 读写（候选池/交易流水/监控/策略，含中文引号转义） -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <!-- 解析中证指数官网成分股/股息率 xls（旧 BIFF 格式，ExcelDataReader 原生支持） -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 投资经验知识库：链接仓库内 trading-system/09_投资经验知识库.md 作为内嵌资源（单一真源，
         不复制文件）。运行期优先读磁盘文件（人工编辑即时生效），回退到这份内嵌副本，
         保证单文件发布与移动端（无项目目录结构）也能加载。 -->
    <EmbeddedResource Include="..\..\trading-system\09_投资经验知识库.md"
                      LogicalName="ThreeBucket.Core.Resources.InvestmentKnowledgeBase.md"
                      Link="Resources\InvestmentKnowledgeBase.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ConfigSchemas\*.json" />
  </ItemGroup>
</Project>
